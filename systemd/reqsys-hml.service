[Unit]
Description=ReqSys (Staging/HML) - Docker Compose Stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/reqsys-admin/reqsys-hml
Environment="COMPOSE_PROJECT_NAME=reqsys-hml"
Environment="BACKEND_PORT_HML=8211"
Environment="POSTGRES_PORT_HML=5433"
Environment="GATEWAY_PORT_HML=8082"
ExecStart=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.hml.yml up -d
ExecStop=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.hml.yml down
RemainAfterExit=yes
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
