[Unit]
Description=ReqSys (Dev) - Docker Compose Stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/reqsys-admin/reqsys-dev
Environment="COMPOSE_PROJECT_NAME=reqsys-dev"
Environment="BACKEND_PORT=8210"
Environment="POSTGRES_PORT=5432"
Environment="GATEWAY_PORT=8081"
ExecStart=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d
ExecStop=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.dev.yml down
RemainAfterExit=yes
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
