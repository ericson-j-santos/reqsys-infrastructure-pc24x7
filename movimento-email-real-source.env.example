# Caminhos locais do host PC24x7. Não versionar os arquivos apontados.
REQSYS_REPO_PATH=/opt/reqsys/reqsys-v2-enterprise-real
MOVIMENTO_EMAIL_SOURCE_DSN_FILE=/etc/reqsys/secrets/movimento-email-source-dsn
MOVIMENTO_EMAIL_TARGET_DSN_FILE=/etc/reqsys/secrets/movimento-email-target-dsn
MOVIMENTO_EMAIL_SOURCE_MAP_FILE=/etc/reqsys/movimento-email/source-map.json
MOVIMENTO_EMAIL_EVIDENCE_DIR=/var/lib/reqsys-24x7/movimento-email/evidence
MOVIMENTO_EMAIL_SYNC_INTERVAL_SECONDS=900
MOVIMENTO_EMAIL_DATA_LAG_DAYS=0
MOVIMENTO_EMAIL_TIMEZONE=America/Sao_Paulo
REQSYS_SOURCE_SHA=replace-with-deployed-sha
